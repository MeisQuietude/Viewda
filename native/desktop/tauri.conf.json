{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewda",
  "identifier": "io.github.meisquietude.viewda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Viewda",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#f4f3ef",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Stepan Savelyev",
    "homepage": "https://github.com/MeisQuietude/Viewda",
    "copyright": "Copyright © 2026 Stepan Savelyev",
    "category": "DeveloperTool",
    "shortDescription": "A free, offline Apache Parquet viewer.",
    "longDescription": "Open local Apache Parquet files to inspect file information and schema without uploading data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMkI2QkY3NDEwOEVGQ0MKUldUTTd3aEI5MnNyd1dPenE5UFdyblg4S2I1aWJ2SWNyNTBlTXhwWmpiRWM3andUOUdlalVORVoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
